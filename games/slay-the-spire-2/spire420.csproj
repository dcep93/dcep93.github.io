<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>spire420</AssemblyName>
    <RootNamespace>Spire420</RootNamespace>
    <Version>0.3.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</GameDir>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(GameDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</GameDataDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs;tools/**/*.cs" />
    <Reference Include="sts2"><HintPath>$(GameDataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDataDir)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckGame" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameDataDir)/sts2.dll')" Text="Game assemblies not found. Set -p:GameDataDir=/path/to/game/data." />
  </Target>
</Project>
